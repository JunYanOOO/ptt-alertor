# Host ports
APP_PORT=19090
GOPS_PORT=16060

# Local URLs. APP_HOST must be a public HTTPS URL when Telegram is enabled.
APP_HOST=http://localhost:19090
APP_WS_HOST=ws://localhost:19090/ws

# Basic authentication for protected APIs
AUTH_USER=admin
AUTH_PW=change-me

# Comma-separated boards checked more frequently
BOARD_HIGH=
AWS_REGION=us-east-1

# Optional notification integrations
DISCORD_TOKEN=
# Optional: register slash commands in one server for immediate development/testing.
# Leave empty to register commands globally.
DISCORD_GUILD_ID=
TELEGRAM_TOKEN=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESSTOKEN=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
MESSENGER_ACCESSTOKEN=
MESSENGER_VERIFYTOKEN=
MAILGUN_DOMAIN=
MAILGUN_APIKEY=
MAILGUN_PUBLIC_APIKEY=
S3_DOMAIN=
